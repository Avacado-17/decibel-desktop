    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "express": "^5.2.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "react-youtube": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
